{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mark-groves/skills-nexus/schemas/skill-components-v1.schema.json",
  "title": "Skills Nexus component metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "components"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "heading",
          "class",
          "protected"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/stableId"
          },
          "source": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\).+\\.(?:md|markdown)$"
          },
          "heading": {
            "type": "string",
            "pattern": "^#{2,6}[ \\t]+[^\\r\\n]+$"
          },
          "class": {
            "$ref": "#/$defs/stableId"
          },
          "protected": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
    }
  }
}
